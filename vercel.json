{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "goka-xi.vercel.app"
        }
      ],
      "destination": "https://beforego.art/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.beforego.art"
        }
      ],
      "destination": "https://beforego.art/$1",
      "permanent": true
    },
    {
      "source": "/(.*)index.html",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/tools/pt-br/ferias-escolares-sao-paulo-2026/",
      "destination": "/tools/pt-br/quantos-dias-faltam-para-as-ferias/",
      "permanent": true
    },
    {
      "source": "/tools/pt-br/ferias-escolares-minas-gerais-2026/",
      "destination": "/tools/pt-br/quantos-dias-faltam-para-as-ferias/",
      "permanent": true
    },
    {
      "source": "/tools/pt-br/ferias-escolares-parana-2026/",
      "destination": "/tools/pt-br/quantos-dias-faltam-para-as-ferias/",
      "permanent": true
    },
    {
      "source": "/tools/pt-br/ferias-escolares-rio-grande-do-sul-2026/",
      "destination": "/tools/pt-br/quantos-dias-faltam-para-as-ferias/",
      "permanent": true
    },
    {
      "source": "/tools/pt-br/ferias-escolares-pernambuco-2026/",
      "destination": "/tools/pt-br/quantos-dias-faltam-para-as-ferias/",
      "permanent": true
    },
    {
      "source": "/tools/th/bai-set-rap-ngoen/",
      "destination": "/tools/th/bai-sanoe-rakha/?doc=receipt",
      "permanent": true
    }
  ]
}
